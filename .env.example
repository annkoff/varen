# ───────────────────────────────────────────────────────────────
# VAREN — environment variables. Copy to .env and fill in.
# Never commit .env — it is git-ignored.
# ───────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local:   postgresql://varen:password@localhost:5432/varen?schema=public
# Neon / Supabase / Yandex Managed PostgreSQL: use the URL from the provider (add ?sslmode=require).
DATABASE_URL="postgresql://varen:CHANGE_ME@localhost:5432/varen?schema=public"

# Secret for signing admin sessions. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Public URL of the site (used in Telegram buttons, sitemap, robots, Open Graph).
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin account — created by `npm run db:seed` if it does not exist yet.
# After the first login change the password in Admin → Settings and remove it from here.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Telegram (manager notifications) ──────────────────────────
# Bot token from @BotFather and the id of the chat that receives leads (see README → Telegram).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Optional: secret for the bot webhook (/api/telegram/webhook) — any random string.
TELEGRAM_WEBHOOK_SECRET=""

# ─── File storage ──────────────────────────────────────────────
# local — files on the server disk (VPS / Docker with a volume)
# s3    — any S3-compatible private bucket (Yandex Object Storage, Selectel, VK Cloud, Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Required when STORAGE_DRIVER=s3
S3_ENDPOINT=""                 # e.g. https://storage.yandexcloud.net
S3_REGION="ru-central1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"    # "true" for MinIO

# Max size of one client file, MB (Vercel: keep ≤ 4 — platform request limit is 4.5 MB).
MAX_UPLOAD_MB="10"

# ─── Yandex Metrika ────────────────────────────────────────────
# Counter id (digits only). Empty — Metrika is not loaded.
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
# Optional: OAuth token with metrika:read — shows Metrika totals in Admin → Analytics.
YANDEX_METRIKA_OAUTH_TOKEN=""

# Docker / self-hosting: set to "standalone" for a minimal server bundle (used by the Dockerfile).
# NEXT_OUTPUT="standalone"
